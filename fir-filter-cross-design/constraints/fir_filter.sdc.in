
# FIR timing constraints.
# run_fir_flow.sh replaces __CLK_PERIOD__ with the clock period in ns.

create_clock -name core_clk -period __CLK_PERIOD__ [get_ports clk]

# Clock uncertainty placeholder; replace with a project-specific value if available.
set_clock_uncertainty 0.1 [get_clocks core_clk]

# Input arrival delays relative to core_clk.
set_input_delay 1.0 -clock core_clk \
    [get_ports {rst valid_in sample_in[*]}]

# Output required-time constraints relative to core_clk.
set_output_delay 1.0 -clock core_clk \
    [get_ports {valid_out sample_out[*]}]

# Input transition and output load assumptions.
set_input_transition 0.1 \
    [get_ports {rst valid_in sample_in[*]}]

set_load 0.01 \
    [get_ports {valid_out sample_out[*]}]
