
# FIR synthesis template.
# The runner replaces __LIB_FILE__ with the absolute Liberty path.
# Outputs are written to fir_project/synth/.

# --------------------------------------------------
# 1. Read RTL and configure the FIR design
# --------------------------------------------------

read_verilog -sv rtl/fir_filter.v

chparam -set DATA_WIDTH 8 \
        -set COEFF_WIDTH 8 \
        -set TAPS 8 \
        -set ACC_WIDTH 24 fir_filter

hierarchy -check -top fir_filter

# --------------------------------------------------
# 2. Convert RTL to a technology-independent netlist
# --------------------------------------------------

proc
flatten
opt
fsm
opt
memory
opt
techmap
opt

# --------------------------------------------------
# 3. Map flip-flops and combinational logic to Sky130HD
# --------------------------------------------------

dfflibmap -liberty "__LIB_FILE__"
abc -liberty "__LIB_FILE__"

opt
clean

# Map constant logic values to Sky130HD tie cells.
hilomap -singleton \
    -hicell sky130_fd_sc_hd__conb_1 HI \
    -locell sky130_fd_sc_hd__conb_1 LO

opt
clean

# --------------------------------------------------
# 4. Validate the synthesized design
# --------------------------------------------------

check -assert

# --------------------------------------------------
# 5. Export synthesized netlist and machine-readable JSON
# --------------------------------------------------

write_json fir_project/synth/fir_filter_netlist.json
write_verilog -noattr -noexpr \
    fir_project/synth/fir_filter_netlist.v

# --------------------------------------------------
# 6. Report synthesis statistics
# --------------------------------------------------

stat -liberty "__LIB_FILE__"
