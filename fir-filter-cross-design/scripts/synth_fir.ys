# ============================================================
# FIR Filter - Yosys Synthesis Diagnostic Script
# Target: Sky130HD
# Configuration: 8-tap, 8-bit input, 8-bit coefficients
# Accumulator width: 24 bits
# ============================================================

# ------------------------------------------------------------
# 1. Read RTL and configure design parameters
# ------------------------------------------------------------

read_verilog -sv rtl/fir_filter.v

chparam -set DATA_WIDTH 8 \
        -set COEFF_WIDTH 8 \
        -set TAPS 8 \
        -set ACC_WIDTH 24 fir_filter

hierarchy -check -top fir_filter


# ------------------------------------------------------------
# 2. RTL process conversion
# ------------------------------------------------------------

echo "===== STAGE 1: RTL PROCESS CONVERSION ====="

proc
opt

stat
check


# ------------------------------------------------------------
# 3. Structural optimization
# ------------------------------------------------------------

echo "===== STAGE 2: STRUCTURAL OPTIMIZATION ====="

flatten
fsm
opt
memory
opt

stat
check


# ------------------------------------------------------------
# 4. Technology-independent mapping
# ------------------------------------------------------------

echo "===== STAGE 3: TECHNOLOGY MAPPING ====="

techmap
opt

stat
check


# ------------------------------------------------------------
# 5. Flip-flop mapping
# ------------------------------------------------------------

echo "===== STAGE 4: FLIP-FLOP MAPPING ====="

dfflibmap -liberty "__LIB_FILE__"

stat
check


# ------------------------------------------------------------
# 6. Combinational logic mapping
# ------------------------------------------------------------

echo "===== STAGE 5: COMBINATIONAL LOGIC MAPPING ====="

abc -liberty "__LIB_FILE__"

opt
clean

stat
check


# ------------------------------------------------------------
# 7. Constant logic mapping
# ------------------------------------------------------------

echo "===== STAGE 6: CONSTANT MAPPING ====="

hilomap -singleton \
    -hicell sky130_fd_sc_hd__conb_1 HI \
    -locell sky130_fd_sc_hd__conb_1 LO

opt
clean

stat
check


# ------------------------------------------------------------
# 8. Final design validation
# ------------------------------------------------------------

echo "===== STAGE 7: FINAL VALIDATION ====="

check -assert


# ------------------------------------------------------------
# 9. Export synthesized netlist and JSON
# ------------------------------------------------------------

echo "===== STAGE 8: EXPORT NETLIST ====="

write_json fir_project/synth/fir_filter_netlist.json

write_verilog -noattr -noexpr \
    fir_project/synth/fir_filter_netlist.v


# ------------------------------------------------------------
# 10. Final synthesis statistics
# ------------------------------------------------------------

echo "===== FINAL SYNTHESIS STATISTICS ====="

stat -liberty "__LIB_FILE__"

echo "===== FIR SYNTHESIS SCRIPT COMPLETED ====="
