# FIR synthesis diagnostic script

read_verilog -sv rtl/fir_filter.v

chparam -set DATA_WIDTH 8 \
        -set COEFF_WIDTH 8 \
        -set TAPS 8 \
        -set ACC_WIDTH 24 fir_filter

hierarchy -check -top fir_filter

# Stage 1: RTL process conversion
proc
opt
stat
check

# Stage 2: Structural optimization
flatten
fsm
opt
memory
opt
stat
check

# Stage 3: Technology-independent mapping
techmap
opt
stat
check

# Stage 4: Flip-flop and combinational mapping
dfflibmap -liberty "__LIB_FILE__"
stat
check

abc -liberty "__LIB_FILE__"
opt
clean
stat
check

# Stage 5: Constant mapping
hilomap -singleton \
    -hicell sky130_fd_sc_hd__conb_1 HI \
    -locell sky130_fd_sc_hd__conb_1 LO

opt
clean
stat
check

# Stage 6: Final validation
check -assert

# Stage 7: Export
write_json fir_project/synth/fir_filter_netlist.json
write_verilog -noattr -noexpr \
    fir_project/synth/fir_filter_netlist.v

stat -liberty "__LIB_FILE__"
